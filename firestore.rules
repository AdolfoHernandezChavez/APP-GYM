rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function pareja() {
      return request.auth != null
        && request.auth.uid in ['UID_ARIEL', 'VV14878XDUak7W3yLWOPScekZbD2'];   // <- pega vuestros UID
    }
    // Ciclo: lo escribe solo la cuenta de Ariel. Si ella prefiere que Eric
    // no lo lea, cambia "pareja()" por request.auth.uid == 'UID_ARIEL' en read.
    match /cycle/{doc} {
      allow read: if pareja();
      allow write: if request.auth != null && request.auth.uid == 'UID_ARIEL';
    }
    match /{document=**} {
      allow read, write: if pareja();
    }
  }
}
